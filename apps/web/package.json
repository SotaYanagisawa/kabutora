{
  "name": "@kabutora/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "build:cloudflare": "node node_modules/@opennextjs/cloudflare/dist/cli/index.js build",
    "preview:cloudflare": "node node_modules/@opennextjs/cloudflare/dist/cli/index.js build && node node_modules/@opennextjs/cloudflare/dist/cli/index.js preview",
    "deploy:cloudflare": "node node_modules/@opennextjs/cloudflare/dist/cli/index.js build && node node_modules/@opennextjs/cloudflare/dist/cli/index.js deploy",
    "start": "node node_modules/next/dist/bin/next start",
    "typecheck": "node ../../node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@kabutora/domain": "workspace:*",
    "@kabutora/market-data": "workspace:*",
    "@noble/hashes": "^2.3.0",
    "decimal.js": "^10.6.0",
    "firebase": "^12.17.1",
    "jose": "^6.2.8",
    "lucide-react": "^0.536.0",
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "wrangler": "^4.120.0"
  }
}

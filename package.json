{
  "name": "kabutora",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "pnpm --filter @kabutora/web dev",
    "build": "pnpm --filter @kabutora/web build",
    "typecheck": "pnpm --filter @kabutora/web typecheck",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore \"node firebase/firestore-rules.mjs\"",
    "verify:privacy": "node scripts/verify-private-data-boundary.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.1",
    "@types/node": "^24.0.0",
    "firebase": "^12.17.1",
    "firebase-tools": "13.35.1",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
